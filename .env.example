# Copy this file to .env in the project root and fill your own provider settings.
# All real-mode commands read .env from the working directory. Never commit .env.
# The endpoint/model must support Chat Completions, function calling and JSON output.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://your-provider.example/v1
OPENAI_MODEL=your-tool-capable-model

# Optional vendor-specific JSON parameters; generic endpoints get no vendor flags.
OPENAI_EXTRA_BODY={}
# Alibaba Qwen non-thinking example (replace the line above if using this provider):
# OPENAI_EXTRA_BODY='{"enable_thinking":false}'
# HTTPS endpoints are supported; HTTP is permitted for localhost/loopback services.
# Use a non-empty dummy key if your local endpoint does not require authentication.
